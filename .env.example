# Copy to .env.local (development) or set in your host's dashboard (Vercel → Settings → Environment Variables).

# --- Lead delivery (set at least one) ---------------------------------------
# Any URL that accepts a JSON POST: Zapier/Make/n8n webhook, HubSpot, Slack, Google Apps Script…
LEAD_WEBHOOK_URL=
# Email via Resend (https://resend.com). LEAD_FROM_EMAIL must be on a domain you verified there.
RESEND_API_KEY=
LEAD_TO_EMAIL=sales@ec4you.com
LEAD_FROM_EMAIL=EC4YOU Website <leads@ec4you.com>

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.ec4you.com

# --- Tracking (all optional; loaded only as consent allows) ------------------
# Google Tag Manager container (manage GA4 + Google Ads conversions inside GTM)
NEXT_PUBLIC_GTM_ID=
# Meta (Facebook/Instagram) Pixel
NEXT_PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag partner ID and the conversion ID for "Lead"
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
